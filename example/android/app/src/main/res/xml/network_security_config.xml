<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS 연결을 허용하고, 특정 도메인에 대해 cleartextTrafficPermitted 설정 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- mobile.barosvc.com 도메인에 대한 설정 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">mobile.barosvc.com</domain>
        <domain includeSubdomains="true">barocall.baro.so</domain>
    </domain-config>
    
    <!-- 개발 환경을 위한 localhost 설정 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
